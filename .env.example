# Copy to .env and fill in for local development.

# Optional: if set, the pipeline calls the real Anthropic API for the
# Analysis Agent's reasoning step. If unset, it falls back to the
# deterministic offline ExtractiveMockLLM (see backend/app/llm_client.py) —
# useful for CI, demos, and offline development.
ANTHROPIC_API_KEY=

# Defaults to local SQLite if unset. Set this to point at Postgres, e.g.
# when running via docker-compose:
# DATABASE_URL=postgresql+psycopg2://frontierops:frontierops@postgres:5432/frontierops
DATABASE_URL=sqlite:///./frontierops.db
